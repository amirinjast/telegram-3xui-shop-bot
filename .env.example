# Required: Telegram bot token from @BotFather.
BOT_TOKEN=PUT_TELEGRAM_BOT_TOKEN_HERE

# Recommended: comma-separated numeric Telegram IDs for bot admins.
# You can get your ID from @userinfobot or @RawDataBot.
ADMIN_IDS=

# Safer default: do not let the first /start user become admin unless explicitly enabled.
ALLOW_FIRST_ADMIN_CLAIM=false

# Optional: override the default SQLite database path.
DATABASE_URL=sqlite+aiosqlite:///./shop.db

# Optional: API/webhook bind address.
APP_HOST=0.0.0.0
APP_PORT=8080
PUBLIC_BASE_URL=http://localhost:8080

# Optional: sales defaults.
USD_RATE_TOMAN=150000
MIN_TOPUP_TOMAN=50000

# Optional: 3x-ui settings. You can also set these inside the Telegram admin panel.
XUI_BASE_URL=
XUI_API_KEY=
XUI_AUTH_HEADER=Authorization
XUI_AUTH_PREFIX=Bearer
XUI_API_PREFIX=/panel/api
XUI_SUBSCRIPTION_BASE_URL=

# Payments.
# NOWPayments is disabled by default; leave it off for manual/wallet-only sales.
NOWPAYMENTS_ENABLED=false
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
CARD_TO_CARD_NUMBER=
CARD_TO_CARD_OWNER=
